+import { create } from "zustand";
+
+// Expansion is a viewing choice for this app session. Restarting folds pushed work again.
+export const useSidebarPushedStore = create<{
+  expanded: ReadonlySet<string>;
+  toggle: (key: string) => void;
+}>((set) => ({
+  expanded: new Set(),
+  toggle: (key) =>
+    set((state) => {
+      const expanded = new Set(state.expanded);
+      if (expanded.has(key)) expanded.delete(key);
+      else expanded.add(key);
+      return { expanded };
+    }),
+}));
