+import type {
+  SidebarWorkspaceEntry,
+  SidebarWorkspacePlacement,
+} from "@/hooks/use-sidebar-workspaces-list";
+
+/** Completion belongs to the task, not the checkout shared by other conversations.
+ * New repository commits or a running preview service do not undo an earlier task's push.
+ */
+export function partitionPushedWorkspaces<T extends SidebarWorkspacePlacement>(
+  items: readonly T[],
+  entries: ReadonlyMap<string, SidebarWorkspaceEntry>,
+  selectedKey?: string | null,
+): { active: T[]; pushed: T[] } {
+  const active: T[] = [];
+  const pushed: T[] = [];
+  for (const item of items) {
+    const entry = entries.get(item.workspaceKey);
+    const fold =
+      entry &&
+      /^🔵\s/u.test(entry.name.trim()) &&
+      (entry.statusBucket === "done" || entry.statusBucket === "attention") &&
+      !entry.pinnedAt &&
+      item.workspaceKey !== selectedKey &&
+      !entry.archivingAt;
+    (fold ? pushed : active).push(item);
+  }
+  return { active, pushed };
+}
