+import { useCallback, useMemo } from "react";
+import { useActiveWorkspaceSelection } from "@/stores/navigation-active-workspace-store";
+import { useSidebarPushedStore } from "@/stores/sidebar-pushed-store";
+import type {
+  SidebarWorkspaceEntry,
+  SidebarWorkspacePlacement,
+} from "@/hooks/use-sidebar-workspaces-list";
+import { partitionPushedWorkspaces } from "./pushed-workspaces";
+
+export function usePushedWorkspaces<T extends SidebarWorkspacePlacement>(
+  items: readonly T[],
+  entries: ReadonlyMap<string, SidebarWorkspaceEntry>,
+  scope: string,
+) {
+  const selection = useActiveWorkspaceSelection();
+  const selectedKey = selection ? `${selection.serverId}:${selection.workspaceId}` : null;
+  const groups = useMemo(
+    () => partitionPushedWorkspaces(items, entries, selectedKey),
+    [items, entries, selectedKey],
+  );
+  const expanded = useSidebarPushedStore((state) => state.expanded.has(scope));
+  const toggle = useSidebarPushedStore((state) => state.toggle);
+  const toggleExpanded = useCallback(() => toggle(scope), [toggle, scope]);
+  return { ...groups, expanded, toggleExpanded };
+}
