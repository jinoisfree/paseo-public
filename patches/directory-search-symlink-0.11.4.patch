+      await expect(result).resolves.toEqual([]);
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it.each(["", "   "])("only searches home for blank input %j", async (query) => {
