--- /dev/null
+++ b/packages/app/src/add-project-flow/directory-search.ts
@@ -0,0 +1,152 @@
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { scorePathMatch } from "@getpaseo/protocol/search/text-match";
+import { isOpenableProjectPath } from "@/components/project-picker-options";
+import { joinDirectoryPath, parentDirectory, pathIdentity } from "./options";
+
+const DIRECTORY_LIMIT = 30;
+const CHILD_LIST_LIMIT = 100;
+const PARENT_LIMIT = 6;
+const SEARCH_TIMEOUT_MS = 5_000;
+
+export function buildDirectorySearchParents(projectPaths: string[]): string[] {
+  const seen = new Set<string>();
+  const parents: string[] = [];
+  for (const projectPath of projectPaths) {
+    const parent = parentDirectory(projectPath.trim());
+    if (!parent || !isOpenableProjectPath(parent)) continue;
+    const identity = pathIdentity(parent);
+    // Do not expand a home directory or its broad /Users and /home ancestors.
+    const normalized = parent.replace(/\\/g, "/").replace(/\/+$/, "");
+    if (
+      !identity ||
+      identity === "~" ||
+      /^\/(?:Users|home)(?:\/[^/]+)?$/u.test(normalized) ||
+      seen.has(identity)
+    )
+      continue;
+    seen.add(identity);
+    parents.push(parent);
+    if (parents.length === PARENT_LIMIT) break;
+  }
+  return parents;
+}
+
+export function splitDirectorySearchPath(
+  query: string,
+): { parent: string; term: string } | null {
+  const path = query.trim();
+  if (!path.startsWith("/") && !path.startsWith("~/")) return null;
+  const index = path.lastIndexOf("/");
+  return { parent: path.slice(0, index) || "/", term: path.slice(index + 1) };
+}
+
+function joinRelativeDirectories(
+  parent: string,
+  paths: string[],
+  maxDepth = Infinity,
+): string[] {
+  return paths.flatMap((path) => {
+    // cwd searches return relative paths; never join an absolute or escaping result.
+    if (isOpenableProjectPath(path)) return [];
+    const parts = path.replace(/\\/g, "/").split("/").filter(Boolean);
+    const segments = parts.filter((part) => part !== ".");
+    if (!segments.length || segments.includes("..") || segments.length > maxDepth) return [];
+    return [segments.reduce(joinDirectoryPath, parent)];
+  });
+}
+
+function uniqueDirectories(paths: string[]): string[] {
+  const seen = new Set<string>();
+  return paths
+    .filter((path) => {
+      const identity = pathIdentity(path);
+      if (seen.has(identity)) return false;
+      seen.add(identity);
+      return true;
+    })
+    .slice(0, DIRECTORY_LIMIT);
+}
+
+export async function fetchProjectDirectoryPaths(input: {
+  client: Pick<DaemonClient, "getDirectorySuggestions">;
+  query: string;
+  parents: string[];
+}): Promise<string[]> {
+  const { client, query, parents } = input;
+  const search = async (
+    searchQuery: string,
+    cwd?: string,
+    limit = DIRECTORY_LIMIT,
+  ): Promise<string[]> => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      return await Promise.race([
+        client
+          .getDirectorySuggestions({
+            query: searchQuery,
+            ...(cwd ? { cwd } : {}),
+            includeDirectories: true,
+            includeFiles: false,
+            limit,
+          })
+          .then(
+            (payload) =>
+              payload.entries?.flatMap((entry) =>
+                entry.kind === "directory" ? [entry.path] : [],
+              ) ?? [],
+          ),
+        new Promise<string[]>((resolve) => {
+          timer = setTimeout(() => resolve([]), SEARCH_TIMEOUT_MS);
+        }),
+      ]);
+    } finally {
+      clearTimeout(timer);
+    }
+  };
+
+  if (query.trim() && !isOpenableProjectPath(query)) {
+    // A blank cwd query lists children without walking the entire project tree.
+    const parentPaths = await Promise.all(
+      parents.slice(0, PARENT_LIMIT).map(async (parent) => {
+        try {
+          return joinRelativeDirectories(
+            parent,
+            (await search("", parent, CHILD_LIST_LIMIT)).filter(
+              (path) => scorePathMatch(query.trim(), path) !== null,
+            ),
+            1,
+          );
+        } catch {
+          return [];
+        }
+      }),
+    );
+    const matches = parentPaths.flat();
+    // Avoid starting a slow home scan when known parents already have matches.
+    if (matches.length) return uniqueDirectories(matches);
+    return uniqueDirectories(await search(query).catch(() => []));
+  }
+
+  const homePaths = await search(query);
+  const pathQuery = splitDirectorySearchPath(query);
+  if (!pathQuery) return uniqueDirectories(homePaths);
+  const parentIdentity = pathIdentity(pathQuery.parent);
+  // A home scan can return fuzzy cache-directory matches to the typed path.
+  // Only results within its parent should prevent a cwd retry.
+  if (
+    homePaths.some((path) => {
+      const identity = pathIdentity(path);
+      return identity === parentIdentity || identity.startsWith(`${parentIdentity}/`);
+    })
+  )
+    return uniqueDirectories(homePaths);
+  try {
+    const paths = await search(pathQuery.term ? `./${pathQuery.term}` : "", pathQuery.parent);
+    return uniqueDirectories([
+      ...joinRelativeDirectories(pathQuery.parent, paths),
+      ...homePaths,
+    ]);
+  } catch {
+    return homePaths;
+  }
+}
