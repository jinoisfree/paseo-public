+import { describe, expect, it, vi } from "vitest";
+import {
+  buildDirectorySearchParents,
+  fetchProjectDirectoryPaths,
+  splitDirectorySearchPath,
+} from "./directory-search";
+
+type Search = Parameters<
+  typeof fetchProjectDirectoryPaths
+>[0]["client"]["getDirectorySuggestions"];
+
+function response(paths: string[], files: string[] = []): Awaited<ReturnType<Search>> {
+  return {
+    requestId: "directory-search-test",
+    directories: paths,
+    entries: [
+      ...paths.map((path) => ({ kind: "directory" as const, path })),
+      ...files.map((path) => ({ kind: "file" as const, path })),
+    ],
+    error: null,
+  };
+}
+
+describe("buildDirectorySearchParents", () => {
+  it("uses only unique recommended parents, excluding home and filesystem root", () => {
+    expect(
+      buildDirectorySearchParents([
+        "/home/example/paseo-work/known",
+        "~/paseo-work/other/",
+        "/home/example/project",
+        "~/project",
+        "/project",
+        "relative/project",
+        "/mnt/demo-data/projects/known",
+      ]),
+    ).toEqual(["/home/example/paseo-work", "/mnt/demo-data/projects"]);
+  });
+
+  it("caps distinct parents at six without adding default directories", () => {
+    const paths = Array.from({ length: 9 }, (_, i) => `/work/${i}/project`);
+    expect(buildDirectorySearchParents(paths)).toEqual(
+      paths.slice(0, 6).map((_, i) => `/work/${i}`),
+    );
+    expect(buildDirectorySearchParents([])).toEqual([]);
+  });
+
+  it("excludes absolute homes and their /Users, /home and root ancestors", () => {
+    expect(
+      buildDirectorySearchParents([
+        "/Users",
+        "/home/example",
+        "/home/example/example-project",
+        "/home",
+        "/home/example",
+        "/home/example/example-project",
+        "~/project",
+        "/project",
+        "/home/example/paseo-work/known",
+        "/home/example/dev/known",
+      ]),
+    ).toEqual(["/home/example/paseo-work", "/home/example/dev"]);
+  });
+
+  it("deduplicates Windows parents without changing their path syntax", () => {
+    expect(
+      buildDirectorySearchParents(["C:\\work\\one", "c:/WORK/two", "\\\\host\\share\\repo"]),
+    ).toEqual(["C:\\work", "\\\\host\\share"]);
+  });
+});
+
+describe("splitDirectorySearchPath", () => {
+  it.each([
+    [" ~/paseo-work/hermes ", { parent: "~/paseo-work", term: "hermes" }],
+    ["/mnt/demo-data/work/hermes", { parent: "/mnt/demo-data/work", term: "hermes" }],
+    ["~/paseo-work/", { parent: "~/paseo-work", term: "" }],
+    ["~/", { parent: "~", term: "" }],
+    ["/hermes", { parent: "/", term: "hermes" }],
+    ["/", { parent: "/", term: "" }],
+    ["hermes", null],
+    ["~", null],
+    ["C:\\work\\hermes", null],
+  ])("splits %s for a cwd search", (query, expected) => {
+    expect(splitDirectorySearchPath(query as string)).toEqual(expected);
+  });
+});
+
+describe("fetchProjectDirectoryPaths", () => {
+  it("lists parent children in parallel and matches names without a home scan", async () => {
+    const pending: (() => void)[] = [];
+    const getDirectorySuggestions = vi.fn<Search>(
+      (options) =>
+        new Promise((resolve) => {
+          pending.push(() =>
+            resolve(
+              options.cwd
+                ? response(
+                    [
+                      "hermes-starter",
+                      "unrelated",
+                      "group/hermes",
+                      "group/deep/hermes",
+                      ".",
+                      "../escape",
+                      "/absolute",
+                    ],
+                    ["hermes.txt"],
+                  )
+                : response(["/home/example/other-hermes"]),
+            ),
+          );
+        }),
+    );
+    const result = fetchProjectDirectoryPaths({
+      client: { getDirectorySuggestions },
+      query: "hermes",
+      parents: ["~/paseo-work", "/mnt/demo-other"],
+    });
+    expect(getDirectorySuggestions).toHaveBeenCalledTimes(2);
+    expect(getDirectorySuggestions.mock.calls.map(([options]) => options.cwd)).toEqual([
+      "~/paseo-work",
+      "/mnt/demo-other",
+    ]);
+    for (const [options] of getDirectorySuggestions.mock.calls) {
+      expect(options).toMatchObject({
+        query: "",
+        includeDirectories: true,
+        includeFiles: false,
+        limit: 100,
+      });
+    }
+    pending.forEach((resolve) => resolve());
+    await expect(result).resolves.toEqual([
+      "~/paseo-work/hermes-starter",
+      "/mnt/demo-other/hermes-starter",
+    ]);
+  });
+
+  it("deduplicates tilde and absolute home paths before enforcing the thirty-result limit", async () => {
+    const children = Array.from({ length: 40 }, (_, i) => `hermes-${i}`);
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd
+        ? response(children)
+        : response(["/home/example/work/hermes-0/", "/home/example/work/hermes-1", "/other/hermes"]),
+    );
+    const paths = await fetchProjectDirectoryPaths({
+      client: { getDirectorySuggestions },
+      query: "hermes",
+      parents: ["~/work"],
+    });
+    expect(paths).toEqual(children.slice(0, 30).map((path) => `~/work/${path}`));
+  });
+
+  it("retains a successful parent when another parent fails", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) => {
+      if (cwd === "/missing") throw new Error("Unavailable");
+      return cwd ? response(["hermes-starter"]) : response(["/home/example/hermes"]);
+    });
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["/missing", "~/work"],
+      }),
+    ).resolves.toEqual(["~/work/hermes-starter"]);
+  });
+
+  it("retains parent results when the home request fails", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) => {
+      if (!cwd) throw new Error("Home scan failed");
+      return response(["hermes-starter"]);
+    });
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["~/work"],
+      }),
+    ).resolves.toEqual(["~/work/hermes-starter"]);
+  });
+
+  it("deduplicates parent aliases without starting a home scan", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd
+        ? response(["hermes-starter"])
+        : response(["/home/example/work/hermes-starter/", "/other/hermes"]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["~/work", "/home/example/work"],
+      }),
+    ).resolves.toEqual(["~/work/hermes-starter"]);
+  });
+
+  it("falls back to home only when child listings have no matching names", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd ? response(["unrelated"]) : response(["/elsewhere/hermes-starter"]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["~/work"],
+      }),
+    ).resolves.toEqual(["/elsewhere/hermes-starter"]);
+    expect(
+      getDirectorySuggestions.mock.calls.map(([options]) => [options.cwd, options.query]),
+    ).toEqual([
+      ["~/work", ""],
+      [undefined, "hermes"],
+    ]);
+  });
+
+  it("joins Windows cwd-relative results and filters by depth", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd ? response(["hermes", "group\\hermes", "group\\deep\\hermes"]) : response([]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["C:\\work"],
+      }),
+    ).resolves.toEqual(["C:\\work\\hermes"]);
+  });
+
+  it("does not start a home scan when parent matches are ready", async () => {
+    vi.useFakeTimers();
+    try {
+      const getDirectorySuggestions = vi.fn<Search>(({ cwd }) =>
+        cwd ? Promise.resolve(response(["hermes", "hermes-starter"])) : new Promise(() => {}),
+      );
+      await expect(
+        fetchProjectDirectoryPaths({
+          client: { getDirectorySuggestions },
+          query: "hermes",
+          parents: ["~/paseo-work"],
+        }),
+      ).resolves.toEqual(["~/paseo-work/hermes", "~/paseo-work/hermes-starter"]);
+      expect(getDirectorySuggestions).toHaveBeenCalledTimes(1);
+      expect(getDirectorySuggestions.mock.calls[0][0].cwd).toBe("~/paseo-work");
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("drops each stalled parent after five seconds and retains completed results", async () => {
+    vi.useFakeTimers();
+    try {
+      const getDirectorySuggestions = vi.fn<Search>(({ cwd }) => {
+        if (cwd === "/slow") return new Promise(() => {});
+        return Promise.resolve(response(cwd ? ["hermes-starter"] : ["/other/hermes"]));
+      });
+      const result = fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: ["/slow", "~/work"],
+      });
+      let settled = false;
+      void result.then(() => {
+        settled = true;
+      });
+      await vi.advanceTimersByTimeAsync(4_999);
+      expect(settled).toBe(false);
+      await vi.advanceTimersByTimeAsync(1);
+      await expect(result).resolves.toEqual(["~/work/hermes-starter"]);
+      expect(vi.getTimerCount()).toBe(0);
+    } finally {
+      vi.useRealTimers();
