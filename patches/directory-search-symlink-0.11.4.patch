+  });
+
+  it("also bounds home-only searches to five seconds", async () => {
+    vi.useFakeTimers();
+    try {
+      const getDirectorySuggestions = vi.fn<Search>(() => new Promise(() => {}));
+      const result = fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "hermes",
+        parents: [],
