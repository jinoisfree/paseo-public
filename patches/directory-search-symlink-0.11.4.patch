+    await fetchProjectDirectoryPaths({
+      client: { getDirectorySuggestions },
+      query,
+      parents: ["~/work"],
+    });
+    expect(getDirectorySuggestions).toHaveBeenCalledTimes(1);
+  });
+
+  it("leaves successful home path queries alone", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async () =>
+      response(["/home/example/work/hermes"]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "~/work/hermes",
+        parents: ["/other"],
+      }),
+    ).resolves.toEqual(["/home/example/work/hermes"]);
+    expect(getDirectorySuggestions).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(["~/paseo-work", "/mnt/demo-data/paseo-work"])(
