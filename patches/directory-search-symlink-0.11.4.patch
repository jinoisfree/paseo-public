+    async (parent) => {
+      const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+        cwd ? response(["hermes", "hermes-starter"]) : response([]),
+      );
+      await expect(
+        fetchProjectDirectoryPaths({
+          client: { getDirectorySuggestions },
+          query: `${parent}/hermes`,
+          parents: ["/unrelated"],
+        }),
+      ).resolves.toEqual([`${parent}/hermes`, `${parent}/hermes-starter`]);
+      expect(
+        getDirectorySuggestions.mock.calls.map(([options]) => [options.cwd, options.query]),
+      ).toEqual([
+        [undefined, `${parent}/hermes`],
+        [parent, "./hermes"],
+      ]);
+    },
+  );
+
+  it("retries path queries when home only finds unrelated fuzzy cache paths", async () => {
+    const cachePath = "/home/example/Library/Caches/claude-cli-nodejs/-home-example-paseo-work-hermes";
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd ? response(["hermes", "hermes-starter"]) : response([cachePath]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
+        client: { getDirectorySuggestions },
+        query: "~/paseo-work/hermes",
+        parents: [],
+      }),
+    ).resolves.toEqual(["~/paseo-work/hermes", "~/paseo-work/hermes-starter", cachePath]);
+    expect(getDirectorySuggestions).toHaveBeenCalledTimes(2);
+  });
+
+  it("lists children when a path query ends in a slash", async () => {
+    const getDirectorySuggestions = vi.fn<Search>(async ({ cwd }) =>
+      cwd ? response(["hermes-starter"]) : response([]),
+    );
+    await expect(
+      fetchProjectDirectoryPaths({
