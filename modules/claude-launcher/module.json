{
  "id": "claude-launcher",
  "description": "claude 제공자 실행기",
  "requires": [
    "python3",
    "claude",
    "macOS-keychain"
  ],
  "installationImpact": [
    "선택한 제공자 command 변경(2차 설치기에서만 적용)"
  ],
  "installs": [
    {
      "source": "modules/claude-launcher/launcher.py",
      "target": "$INSTALL_ROOT/modules/claude-launcher/launcher.py"
    },
    {
      "source": "modules/launcher_runtime.py",
      "target": "$INSTALL_ROOT/modules/launcher_runtime.py"
    }
  ],
  "vaultKeys": [
    "keychain.claude.service",
    "keychain.claude.account"
  ],
  "policyKeys": [
    "decisions.modules"
  ],
  "conflicts": [
    {
      "kind": "provider-command",
      "provider": "claude"
    }
  ]
}
