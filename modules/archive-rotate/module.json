{
  "id": "archive-rotate",
  "description": "Paseo archive-rotate 설비",
  "requires": [
    "Paseo.app",
    "python3"
  ],
  "installationImpact": [
    "공항 LaunchAgent 생성"
  ],
  "installs": [
    {
      "source": "modules/archive-rotate/job.plist.in",
      "target": "$LAUNCH_AGENTS/io.github.jinoisfree.paseo-public.archive-rotate.plist"
    },
    {
      "source": "modules/archive-rotate/run.py",
      "target": "$INSTALL_ROOT/modules/archive-rotate/run.py"
    },
    {
      "source": "modules/service_runtime.py",
      "target": "$INSTALL_ROOT/modules/service_runtime.py"
    },
    {
      "source": "modules/launcher_runtime.py",
      "target": "$INSTALL_ROOT/modules/launcher_runtime.py"
    },
    {
      "source": "plugin/role-workflow/shared/presets/recommended.json",
      "target": "$INSTALL_ROOT/presets/recommended.json"
    }
  ],
  "vaultKeys": [
    "paths.app",
    "paths.python"
  ],
  "policyKeys": [
    "decisions.modules"
  ],
  "conflicts": [
    {
      "kind": "script-content",
      "patterns": [
        "codex-home/sessions",
        "archive_records"
      ]
    }
  ]
}
