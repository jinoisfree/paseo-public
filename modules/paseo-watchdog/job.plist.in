<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.jinoisfree.paseo-public.paseo-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__INSTALL_ROOT__/modules/paseo-watchdog/run.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PASEO_HOME</key>
		<string>__PASEO_HOME__</string>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__INSTALL_ROOT__/logs/paseo-watchdog.out.log</string>
	<key>StandardErrorPath</key>
	<string>__INSTALL_ROOT__/logs/paseo-watchdog.err.log</string>
	<key>StartInterval</key>
	<integer>60</integer>
</dict>
</plist>
