<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>io.github.jinoisfree.paseo-public.auto-update</string>
<key>ProgramArguments</key><array><string>__PYTHON__</string><string>__REPOSITORY__/scripts/auto-update.py</string></array>
<key>WorkingDirectory</key><string>__HOME__</string>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>PATH</key><string>__PATH__</string><key>PASEO_HOME</key><string>__PASEO_HOME__</string><key>PASEO_PUBLIC_CONFIG</key><string>__CONFIG__</string></dict>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
<key>RunAtLoad</key><false/>
<key>LimitLoadToSessionType</key><string>Aqua</string>
<key>StandardOutPath</key><string>__LOGS__/auto-update/stdout.log</string>
<key>StandardErrorPath</key><string>__LOGS__/auto-update/stderr.log</string>
</dict></plist>
