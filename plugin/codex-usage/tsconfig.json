{
  "compilerOptions": {
    "target": "ES2023",
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.server.ts",
    "server/**/*.ts",
    "shared/**/*.ts"
  ]
}
