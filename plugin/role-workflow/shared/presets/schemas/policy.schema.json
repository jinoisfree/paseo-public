            "value": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "phoneNotifications": {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "phoneNotificationEndpoint": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "core": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "roleWorkflow": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "manuals": {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
        },
        "keepRunningAfterQuit": {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "value",
            "date"
          ],
          "additionalProperties": false
