{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "installationImpact": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "installs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          }
        },
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false
      }
    },
    "vaultKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policyKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "paseo-command",
              "watch-app",
              "script-content",
              "plugin-source",
              "provider-command"
            ]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "enum": [
              "claude",
              "codex"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "defaultVariant": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    }
  },
  "required": [
    "id",
    "description",
    "requires",
    "installationImpact",
    "installs",
    "vaultKeys",
    "policyKeys"
  ],
  "additionalProperties": false
}
