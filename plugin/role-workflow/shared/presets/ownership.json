      "slot": "core-config"
    },
    "claude-provider.sh": {
      "slot": "equipment",
      "migration": "기존 운영 설치물·잔재. 대체 후 4차 정리"
    },
    "plugin-mirror": {
      "slot": "equipment",
      "migration": "기존 운영 설치물·잔재. 대체 후 4차 정리"
    },
    "role-workflow": {
      "slot": "facility",
      "children": {
        "state.json": "lockers",
        "rules": "facility-generated",
        "guides": "facility-generated",
        "push-guard.gitconfig": "facility-generated",
        "push-guard.global.gitconfig": "facility-generated",
        "handoffs": "lockers",
        "pushes": "lockers",
        "evidence": "lockers",
        "artifacts": "lockers",
        "task-artifacts": "lockers",
        "rules-status.json": "facility-generated"
      },
      "migration": "state.json.settings는 롤백용 동결 사본. 현재 설정은 owner/policy.json; projects 기억은 사물함 유지"
    },
    "pipeline": {
      "slot": "installation",
      "migration": "기존 운영 설치물·잔재. 대체 후 4차 정리"
    },
    "owner": {
      "slot": "policy",
      "children": {
        "vault.json": "vault",
        "policy.json": "policy"
      },
      "note": "컨테이너만 공유하며 각 파일의 칸은 독립적"
    },
    "claude-home": {
      "slot": "lockers",
      "children": {
        "settings.json": "equipment",
        "skills": "equipment"
      },
      "note": "settings·스킬 링크는 설비 생성물, 링크 대상은 본체/선택한 사장 매뉴얼, 세션·auth는 사물함"
    },
    "airport": {
      "slot": "installation",
      "target": "공항 설치 기록·설비 생성물·로그"
    },
    "archive": {
      "slot": "lockers",
      "target": "제품 세션 보관본(원본 삭제 전 확인)"
    }
  },
  "config": {
    "$schema": {
      "slot": "core-config"
    },
    "version": {
      "slot": "core-config"
    },
    "daemon.listen": {
      "slot": "core-config"
    },
    "daemon.mcp.*": {
      "slot": "core-config"
    },
    "daemon.browserTools.*": {
      "slot": "core-config"
    },
    "daemon.autoArchiveAfterMerge": {
      "slot": "core-config"
    },
    "daemon.relay.*": {
      "slot": "core-config"
    },
    "pluginsEnabled": {
      "slot": "core-config"
    },
    "plugins.*": {
      "slot": "core-config"
    },
    "worktrees.root": {
      "slot": "core-config"
    },
    "agents.providers.*.command": {
      "slot": "core-config"
    },
    "agents.providers.*.env.*": {
      "slot": "core-config",
      "note": "인증 비밀은 본체 신원·비밀, 경로는 금고에서 조립. 소유 원본은 본체 config"
    },
    "agents.providers.*.additionalModels": {
      "slot": "core-config"
    },
    "agents.providers.*.enabled": {
      "slot": "core-config"
    },
    "agents.resumeOnStartup": {
      "slot": "core-config"
    },
    "agents.skills.*": {
      "slot": "core-config"
    },
    "features.*": {
      "slot": "core-config"
    },
    "log.*": {
      "slot": "core-config"
    },
    "daemon.agentProfiles": {
      "slot": "roster"
    }
  },
  "publicConfig": {
    "node": {
      "slot": "vault",
      "target": "paths.node"
    },
    "python": {
      "slot": "vault",
      "target": "paths.python"
    },
    "paseo": {
      "slot": "vault",
      "target": "paths.app"
    },
    "app": {
      "slot": "vault",
      "target": "paths.app"
    },
    "backupDir": {
      "slot": "vault",
      "target": "paths.backupDir"
    },
    "phoneNotifications": {
      "slot": "policy",
      "target": "notifications.phoneNotifications"
    },
    "phoneNotificationEndpoint": {
      "slot": "policy",
      "target": "notifications.phoneNotificationEndpoint"
    },
    "dependenciesLock": {
      "slot": "installation",
      "target": "체크아웃별 설치 상태"
    },
    "profiles.*": {
      "slot": "maintenance",
      "target": "옛 프로필 합성값, 2차 이관 후 4차 제거"
    },
    "buildDir": {
      "slot": "maintenance",
      "target": "읽는 곳 없는 잔재"
    },
    "distTemplate": {
      "slot": "maintenance",
      "target": "읽는 곳 없는 잔재"
    },
    "pluginPath": {
      "slot": "maintenance",
      "target": "읽는 곳 없는 잔재"
    },
    "foldLabel": {
      "slot": "maintenance",
      "target": "읽는 곳 없는 잔재"
    }
  },
  "desktopSettings": {
    "version": {
      "slot": "core-desktop"
    },
    "settings.releaseChannel": {
      "slot": "core-desktop"
    },
    "settings.notifications.*": {
      "slot": "core-desktop"
    },
    "settings.daemon.manageBuiltInDaemon": {
      "slot": "core-desktop"
    },
    "settings.daemon.keepRunningAfterQuit": {
      "slot": "core-desktop"
    },
    "migrations.*": {
      "slot": "core-desktop"
    }
  },
  "locations": {
    "plugin/role-workflow/rules/": "manuals",
    "plugin/role-workflow/shared/presets/": "presets",
    "plugin/role-workflow/shared/presets/profiles.json": "presets",
    "modules/": "equipment",
    "scripts/": "facility",
    "$PASEO_HOME/role-workflow/rules/": "facility-generated",
    "$PASEO_HOME/role-workflow/guides/": "facility-generated",
    "~/Library/LaunchAgents/": "schedule",
    "~/Library/Application Support/paseo-public/": "installation",
    "~/Library/Logs/paseo-public/": "installation",
    "~/Library/Application Support/Paseo/window-state.json": "core-runtime",
    "~/Library/Application Support/Paseo/Local Storage/": "core-runtime",
    "~/Library/Application Support/Paseo/IndexedDB/": "core-runtime",
    "~/Library/Logs/Paseo/": "core-runtime",
    "Homebrew/cask/Paseo": "core-install",
    "~/.zshrc": "owner-shell",
    "~/.claude/skills/": "owner-manuals",
    "~/.agents/skills/": "owner-manuals",
    "~/.config/paseo-public/sync-deny.txt": "maintenance",
    "docs/changes/": "maintenance",
    "$PASEO_HOME/airport/": "installation",
    "$PASEO_HOME/airport/modules/": "equipment",
    "plugin/codex-usage/": "equipment"
  },
  "externalDependencies": [
    "다른 macOS 계정의 앱 공유·데몬",
    "외부 자동화의 Paseo CLI 참조",
    "외부 사용량 앱의 제품 홈 참조",
    "VPN·휴대폰 연결"
  ],
  "inventoryRule": "정확한 이름을 우선하고 *는 한 config 키, 끝의 *는 하위 트리다. 미일치 항목은 미확정으로 보고하며 자동 삭제하지 않는다.",
  "roleWorkflowSettings": {
    "reviewerMode": {
      "slot": "policy",
      "recommended": "shared/presets/recommended.json#/roleWorkflow/reviewerMode"
    },
    "claudeReviewerMode": {
      "slot": "policy",
      "recommended": "shared/presets/recommended.json#/roleWorkflow/claudeReviewerMode"
    }
  }
